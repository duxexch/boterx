# Boterx — Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit the actual .env file to git!

# === Telegram Bot ===
# REQUIRED: Your bot token from @BotFather
BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789,987654321
SUPPORT_USERNAME=your_support_username

# === Flask / Dashboard ===
SECRET_KEY=change_this_to_a_random_64_char_hex_string
# Set to 'production' on your VPS — enables security lockdown checks
APP_ENV=production
DASHBOARD_URL=https://your-domain.com

# === Security (CRITICAL — read before deploying) ===
#
# BOT_TOKEN (above) is REQUIRED in production.
# If BOT_TOKEN is missing and APP_ENV=production, all game API endpoints
# return 503 and log a CRITICAL error — the API is administratively locked
# down rather than silently falling back to unauthenticated access.
#
# ALLOW_DEV_AUTH — NEVER set this in production.
# When true, game endpoints accept a plain ?uid= parameter with no HMAC
# verification. Safe ONLY for local development (no real money involved).
# ALLOW_DEV_AUTH=true   ← uncomment ONLY for local dev, never on VPS

# Comma-separated list of allowed webhook IP ranges (optional)
# WEBHOOK_SECRET=change_this_too

# === Database ===
# Defaults to boterx.db alongside the script
# BOTERX_DB=/path/to/boterx.db

# === Gunicorn (optional overrides) ===
# WORKERS=2
# THREADS=4
# BIND=127.0.0.1:8000

# === Game Engines ===
# Aviator / Crash RTP (Return to Player %)
# AVIATOR_RTP=97
# CRASH_RTP=97
