# Boterx — Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit the actual .env file to git!

# === Telegram Bot ===
# REQUIRED in production: Your bot token from @BotFather
BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789,987654321
SUPPORT_USERNAME=your_support_username

# === Flask / Dashboard ===
SECRET_KEY=change_this_to_a_random_64_char_hex_string
# Set to 'production' on your VPS — enables security lockdown checks
APP_ENV=production
DASHBOARD_URL=https://your-domain.com

# === Security (CRITICAL — read before deploying) ===
#
# BOT_TOKEN (above) is REQUIRED in production.
# If BOT_TOKEN is missing and APP_ENV=production, all game API endpoints
# return 503 and log a CRITICAL error — the API is administratively locked
# down rather than silently falling back to unauthenticated access.
#
# ALLOW_DEV_AUTH — NEVER set this in production.
# When true (and APP_ENV != production), game endpoints accept a plain
# ?uid= parameter with no HMAC verification. Safe ONLY for local dev.
# ALLOW_DEV_AUTH=true   ← uncomment ONLY for local dev, never on VPS
#
# ALERT_BOT_TOKEN — optional dedicated bot for lockdown notifications.
# If BOT_TOKEN goes missing in production, the dashboard uses this token
# to send a Telegram alert to every uid in ADMIN_USER_IDS.
# Can be the same as BOT_TOKEN (copied here for safety), or a separate bot.
# If absent, the dashboard falls back to BOT_TOKEN from .env, then writes
# /tmp/boterx_lockdown as a sentinel for external health-check scripts.
# ALERT_BOT_TOKEN=your_alert_bot_token_here

# === Health Check ===
# GET /health returns {"status":"ok"} (200) or {"status":"locked_down"} (503)
# Add this URL to UptimeRobot / BetterStack to page on lockdown events.
# Example: https://your-domain.com/health

# === Database ===
# Defaults to boterx.db alongside the script
# BOTERX_DB=/path/to/boterx.db

# === Gunicorn (optional overrides) ===
# WORKERS=2
# THREADS=4
# BIND=127.0.0.1:8000

# === Game Engines ===
# Aviator / Crash RTP (Return to Player %)
# AVIATOR_RTP=97
# CRASH_RTP=97
