modules = ["nodejs-24", "python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd dashboard && DASHBOARD_PORT=5000 DASHBOARD_HOST=0.0.0.0 ADMIN_USER_IDS=999000111 DASHBOARD_PASSWORD=localtest123 DASHBOARD_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef APP_ENV=development python app.py"
waitForPort = 5000
